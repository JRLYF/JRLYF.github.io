---
type Props = { name: string; class?: string };
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.35"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "book" && (
      <>
        <>
          <path d="M12 5.5C9 3.5 5.5 3.5 3 4.5v15c2.5-1 6-1 9 1 3-2 6.5-2 9-1v-15c-2.5-1-6-1-9 1Z" />
          <path d="M12 5.5v15M6 8h3M6 11h3M15 8h3M15 11h3" />
        </>
      </>
    )
  }
  {
    name === "game" && (
      <>
        <>
          <path d="M7 7h10c2 0 3 2 3.5 4l1 5c.5 3-2 4-4 2l-2-2h-7l-2 2c-2 2-4.5 1-4-2l1-5C4 9 5 7 7 7Z" />
          <path d="M7.5 10v5M5 12.5h5M12 7V4" />
          <circle cx="16" cy="11" r=".65" />
          <circle cx="18" cy="14" r=".65" />
        </>
      </>
    )
  }
  {
    name === "camera" && (
      <>
        <>
          <path d="m8 6 1.5-2h5L16 6h4a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z" />
          <circle cx="12" cy="13" r="4" />
          <path d="M17.5 9h.5" />
        </>
      </>
    )
  }
  {
    name === "sparkles" && (
      <>
        <>
          <path d="m12 2 2.8 7.2L22 12l-7.2 2.8L12 22l-2.8-7.2L2 12l7.2-2.8Z" />
          <path d="m20 2 .6 1.4L22 4l-1.4.6L20 6l-.6-1.4L18 4l1.4-.6Z" />
        </>
      </>
    )
  }
  {
    name === "pen" && (
      <>
        <>
          <path d="m15 4 5 5M4 20l5-1L21 7a2 2 0 0 0-5-5L4 14l-1 7Z" />
          <path d="m5 15 4 4" />
        </>
      </>
    )
  }
</svg>
