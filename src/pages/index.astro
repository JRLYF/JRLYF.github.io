---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import SectionIcon from "@/components/SectionIcon.astro";
import EmptyState from "@/components/EmptyState.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { categories } from "@/data/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getBlogUrl } from "@/utils/getBlogUrl";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const posts = getSortedPosts(await getCollection("posts"));
const locale = Astro.currentLocale ?? config.site.lang;
const recent = posts.slice(0, config.posts.perIndex);
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="app-layout home-main"
    data-backurl={getRelativeLocaleUrl(locale, "")}
  >
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="status-dot"></span>@LYF0422
        </p>
        <h1 id="hero-title">Yifan <em>Liu.</em></h1>
        <a class="hero-journal-link" href={getBlogUrl()}
          >Blog <IconArrowRight width={18} height={18} /></a
        >
      </div>
      <div class="hero-portrait">
        <img
          src={getAssetPath("images/avatar.webp")}
          width="240"
          height="240"
          alt="Yifan 的头像"
          fetchpriority="high"
        />
        <span class="portrait-star" aria-hidden="true">✦</span>
      </div>
    </section>
    <section class="collections-section" aria-labelledby="collections-title">
      <div class="section-heading">
        <h2 id="collections-title">Collections</h2>
      </div>
      <div class="collection-grid">
        {
          categories
            .filter(category => category.id !== "notes")
            .map(category => (
              <a
                class={`collection-link collection-${category.id}`}
                href={getBlogUrl(category.id)}
              >
                <span class="collection-icon">
                  <SectionIcon name={category.icon} />
                </span>
                <h3>{category.title}</h3>
                <span class="collection-bottom">
                  <span>
                    {String(
                      posts.filter(post => post.data.category === category.id)
                        .length
                    ).padStart(2, "0")}
                  </span>
                  <IconArrowRight width={18} height={18} />
                </span>
              </a>
            ))
        }
      </div>
    </section>
    <section class="recent-section" aria-labelledby="recent-title">
      <div class="section-heading">
        <h2 id="recent-title">最近更新</h2>
        <a class="text-link" href={getBlogUrl()}
          >全部 <span aria-hidden="true">↗</span></a
        >
      </div>
      {
        recent.length > 0 ? (
          <ul class="post-list">
            {recent.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <EmptyState />
        )
      }
      <a class="notes-link text-link" href={getBlogUrl("notes")}
        >Notes <span aria-hidden="true">↗</span></a
      >
    </section>
  </main>
  <Footer />
</Layout>
<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>(".home-main");
    if (main?.dataset.backurl)
      sessionStorage.setItem("backUrl", main.dataset.backurl);
  });
</script>
