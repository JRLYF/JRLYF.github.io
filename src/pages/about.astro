---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing src/content/pages/about.md");
const { Content } = await render(about);
---

<Layout
  title={`About | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />
  <main id="main-content" class="app-layout">
    <header class="page-intro">
      <p class="eyebrow">
        <span class="status-dot"></span> THE PERSON BEHIND THE NOTES
      </p><h1>About me<span class="heading-period">.</span></h1><p
        class="page-description"
      >
        在这里，认识文字背后的那个人。
      </p>
    </header>
    <div class="about-layout">
      <aside class="about-identity">
        <div class="about-avatar" aria-label="个人头像占位">y.</div><h2>
          {config.site.author}
        </h2><p>Reading · Games · Photography</p>{
          config.socials
            .filter(social => social.name === "github")
            .map(social => (
              <a
                class="text-link"
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub <span aria-hidden="true">↗</span>
              </a>
            ))
        }
      </aside>
      <article class="about-content" data-pagefind-body>
        <div class="app-prose"><Content /></div><p class="about-placeholder">
          更多关于我的故事，之后慢慢补上。
        </p>
      </article>
    </div>
  </main>
  <Footer />
</Layout>
